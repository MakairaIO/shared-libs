{
    "name": "makaira/shared-libs",
    "type": "library",
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "pdepend/pdepend": "@stable",
        "phpmd/phpmd": "@stable",
        "squizlabs/php_codesniffer": "@stable"
    },
    "require": {
        "php": "^7.0 | ^8.0",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "autoload": {
        "psr-4": {
            "Makaira\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Makaira\\Test\\": "tests/"
        }
    }
}
